# === Supabase ===
# URL do projeto Supabase usado por todo o sistema (trilhas, leads, CRM de SDR).
SUPABASE_URL=https://hasptpxcyavfdzxtwpws.supabase.co
# Chave pública (anon). É seguro expor no frontend (fica hardcoded em supabase/config.js) — protegida por RLS.
SUPABASE_ANON_KEY=your-anon-key
# Chave de admin total do banco. NUNCA expor no frontend. Usada só dentro das Edge Functions (supabase/functions/*).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === ActiveCampaign ===
# Conta ActiveCampaign usada para e-mail marketing e automações de nutrição de leads.
ACTIVECAMPAIGN_BASE_URL=https://youraccount.api-us1.com
ACTIVECAMPAIGN_API_TOKEN=your-activecampaign-api-token
# Segredo compartilhado usado para validar os webhooks que a AC chama de volta (envio de e-mail, clique em link).
AC_WEBHOOK_SECRET=

# Listas do ActiveCampaign — uma por trilha/funil. Cada par ID+NOME identifica a lista de contatos
# que recebe a sequência de e-mails daquela trilha específica.
ACTIVECAMPAIGN_LIST_ID=
ACTIVECAMPAIGN_LIST_NAME=Trilhaifrs
ACTIVECAMPAIGN_GESTAO_LIST_ID=
ACTIVECAMPAIGN_GESTAO_LIST_NAME=TrilhaGestaoProducaoIA
ACTIVECAMPAIGN_GESTAOPROJETOS_LIST_ID=
ACTIVECAMPAIGN_GESTAOPROJETOS_LIST_NAME=TrilhaGestaoProjetos
ACTIVECAMPAIGN_FINANCAS_LIST_ID=50
ACTIVECAMPAIGN_FINANCAS_LIST_NAME=TrilhaFinancas
ACTIVECAMPAIGN_GDE_LIST_ID=66
ACTIVECAMPAIGN_GDE_LIST_NAME=TrilhaGDE
ACTIVECAMPAIGN_MARKETING_LIST_ID=35
ACTIVECAMPAIGN_MARKETING_LIST_NAME=TrilhaMarketing
ACTIVECAMPAIGN_MARKETING_NOVA_LIST_ID=72
ACTIVECAMPAIGN_MARKETING_NOVA_LIST_NAME=TrilhaMarketingNova
ACTIVECAMPAIGN_GESTAO_TI_LIST_ID=77
ACTIVECAMPAIGN_GESTAO_TI_LIST_NAME=TrilhaPocketGestaoTI
ACTIVECAMPAIGN_GEDAT_LIST_ID=75
ACTIVECAMPAIGN_GEDAT_LIST_NAME=TrilhaGedat
# Lista-gatilho da automação de nutrição por e-mail da Situação A (CRM de SDR, trilha de marketing).
# Entrar nessa lista dispara a automação "TRILHA MKT" (id 137) dentro do ActiveCampaign.
ACTIVECAMPAIGN_SITUACAO_A_LIST_ID=73

# === Ploomes (CRM comercial) ===
PLOOMES_BASE_URL=https://public-api2.ploomes.com
PLOOMES_API_KEY=your-ploomes-api-key
# Pipeline/etapa padrão onde entram os deals das trilhas "normais" (IFRS, Gestão, etc).
PLOOMES_PIPELINE_ID=50001415
PLOOMES_STAGE_ID=50008137
# Pipeline/etapa específicos da trilha nova de marketing (fluxo e nomenclatura de deal diferentes).
PLOOMES_MARKETING_NOVA_PIPELINE_ID=50009841
PLOOMES_MARKETING_NOVA_STAGE_ID=50046553
# Pipeline usado quando um lead qualificado é enviado para o time comercial (Situação C do CRM de SDR).
PLOOMES_COMMERCIAL_PIPELINE_ID=

# === Meta (Facebook/Instagram Ads) ===
# Usados para enviar eventos de conversão (Lead, qualify_lead) via Conversions API.
META_PIXEL_ID=your-meta-pixel-id
META_ACCESS_TOKEN=your-meta-access-token
META_GRAPH_API_VERSION=v23.0
# Código de teste do Meta Events Manager — deixar vazio em produção.
META_TEST_EVENT_CODE=

# === Google Analytics 4 ===
# Usados para enviar o evento "qualify_lead" via Measurement Protocol.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-ga4-api-secret

# === Vercel ===
# Token de API da Vercel (CLI) — usado só em scripts locais/manuais de deploy, não é lido por nenhuma Edge Function.
VERCEL_TOKEN=your-vercel-token
